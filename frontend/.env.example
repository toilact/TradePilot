# URL backend FastAPI (dev mặc định localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Auth.js v5 — Google-only (M9). AUTH_SECRET ký session JWT HS256, PHẢI TRÙNG y hệt
# AUTH_SECRET phía backend (FastAPI verify token). Sinh: openssl rand -base64 32.
AUTH_SECRET=
# Google OAuth Client (Google Cloud Console). Redirect URI:
#   dev   http://localhost:3000/api/auth/callback/google
#   prod  https://<vercel-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tùy chọn: trustHost=true nên KHÔNG bắt buộc; chỉ set nếu Auth.js không tự suy ra URL.
# AUTH_URL=http://localhost:3000

# Sentry (M4) — rỗng = tắt, build/app vẫn chạy bình thường
NEXT_PUBLIC_SENTRY_DSN=
