# Upstash Redis (cache prediction)
REDIS_URL=

# LLM auto-label sentiment (chỉ dùng khi gán nhãn data — chọn 1)
OPENAI_API_KEY=
GEMINI_API_KEY=

# App
APP_ENV=development
LOG_LEVEL=INFO
