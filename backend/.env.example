# Supabase (PostgreSQL) — dùng connection string async (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
SUPABASE_URL=
SUPABASE_KEY=

# Upstash Redis (cache read API — M6). LẤY Ở TAB "Redis connect" (KHÔNG phải REST token):
# dạng rediss://default:<PASSWORD>@<host>.upstash.io:6379 — rỗng/sai → app vẫn sống, không cache
REDIS_URL=

# LLM auto-label sentiment (chỉ dùng khi gán nhãn data — chọn 1)
OPENAI_API_KEY=
GEMINI_API_KEY=
# Key phụ (M8 autolabel): free tier ~20 req/NGÀY/key → thêm key để xoay vòng gán nhiều hơn/ngày
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# App
APP_ENV=development
LOG_LEVEL=INFO

# Observability (M4) — rỗng = tắt, app vẫn chạy bình thường
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# M5: APScheduler in-app (default false — trigger chính là launchd 16:05, xem scripts/launchd/)
ENABLE_SCHEDULER=false

# M7: CORS production — origin cách nhau dấu phẩy; regex cho Vercel preview (rỗng = tắt)
# Render: ALLOWED_ORIGINS=https://trade-pilot-kato.vercel.app  ALLOWED_ORIGIN_REGEX=^https://trade-pilot-kato-.*\.vercel\.app$
ALLOWED_ORIGINS=http://localhost:3000
ALLOWED_ORIGIN_REGEX=

# M9: secret JWT session (HS256). PHẢI TRÙNG y hệt AUTH_SECRET phía frontend (Auth.js v5).
# Sinh: openssl rand -base64 32. Rỗng = chưa bật auth → request watchlist trả 401.
AUTH_SECRET=
