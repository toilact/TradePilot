# Supabase (PostgreSQL) — dùng connection string async (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@[HOST]:5432/postgres
SUPABASE_URL=
SUPABASE_KEY=

# Upstash Redis (cache prediction)
REDIS_URL=

# LLM auto-label sentiment (chỉ dùng khi gán nhãn data — chọn 1)
OPENAI_API_KEY=
GEMINI_API_KEY=

# App
APP_ENV=development
LOG_LEVEL=INFO

# Observability (M4) — rỗng = tắt, app vẫn chạy bình thường
SENTRY_DSN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# M5: APScheduler in-app (default false — trigger chính là launchd 16:05, xem scripts/launchd/)
ENABLE_SCHEDULER=false
